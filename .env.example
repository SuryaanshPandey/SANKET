# Environment configuration for Clarity Document Extraction Platform

# Database
# For PostgreSQL: postgresql+psycopg://user:password@localhost:5432/clarity
# For SQLite local fallback: sqlite:///./clarity.db
DATABASE_URL=sqlite:///./clarity.db

# Storage
# STORAGE_BACKEND: "local" or "s3"
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage

# S3 / MinIO Settings (used if STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=clarity-documents
S3_REGION_NAME=us-east-1

# VLM Inference (Ollama or vLLM OpenAI-compatible endpoint)
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_API_KEY=ollama
VLM_DEFAULT_MODEL=qwen3-vl:8b
VLM_THINKING_MODEL=qwen3-vl:8b-thinking
VLM_DISABLE_THINKING=true
VLM_TIMEOUT_SECONDS=120

# Validation Thresholds
CONFIDENCE_THRESHOLD=0.85
MAX_FLAGGED_FIELDS_BEFORE_ESCALATION=2
DUAL_RUN_TEMPERATURE=0.3
ARITHMETIC_TOLERANCE=0.02
